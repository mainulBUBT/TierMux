      {
        "command": "tiermux.explainSelection",
        "title": "Explain Selection",
        "category": "TierMux"
      },
      {
        "command": "tiermux.fixSelection",
        "title": "Fix Selection",
        "category": "TierMux"
      },
      {
        "command": "tiermux.refactorSelection",
        "title": "Refactor Selection",
        "category": "TierMux"
      },
      {
        "command": "tiermux.generateTests",
        "title": "Generate Tests",
        "category": "TierMux"
      },
      {
        "command": "tiermux.generateDocs",
        "title": "Generate Docs",
        "category": "TierMux"
      },
      {
        "command": "tiermux.fixWithAI",
        "title": "Fix with AI",
        "category": "TierMux"
      },
      {
        "command": "tiermux.inlineChat",
        "title": "Inline Chat (Edit at Cursor)",
        "category": "TierMux"
      },
      {
        "command": "tiermux.addSelectionToChat",
        "title": "Add Selection to Chat",
        "category": "TierMux"
      },
      {
        "command": "tiermux.reconnectMcp",
        "title": "Reconnect MCP Servers",
        "category": "TierMux"
      },
      {
        "command": "tiermux.refreshModels",
        "title": "Refresh Model Catalog",
        "category": "TierMux",
        "icon": "$(sync)"
      },
      {
        "command": "tiermux.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "TierMux",
        "icon": {
          "light": "media/icon-commit-light.svg",
          "dark": "media/icon-commit-dark.svg"
        }
      },
      {
        "command": "tiermux.toggleCompletions",
        "title": "Toggle Inline Completions",
        "category": "TierMux"
      },
      {
        "command": "tiermux.editMemory",
        "title": "Edit Style & Tone Memory",
        "category": "TierMux",
        "icon": "$(notebook)"
      },
      {
        "command": "tiermux.addSkill",
        "title": "Add Skill from GitHub",
        "category": "TierMux",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tiermux.verifyGrounding",
        "title": "Verify Grounding",
        "category": "TierMux"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tiermux.newChat",
          "when": "view == tiermux.chat",
          "group": "navigation@1"
        },
        {
          "command": "tiermux.showHistory",
          "when": "view == tiermux.chat",
          "group": "navigation@2"
        },
        {
          "command": "tiermux.openModelSettings",
          "when": "view == tiermux.chat",
          "group": "navigation@3"
        },
        {
          "command": "tiermux.compactChat",
          "when": "view == tiermux.chat",
          "group": "1_tiermux@1"
        },
        {
          "command": "tiermux.generateHandoff",
          "when": "view == tiermux.chat",
          "group": "1_tiermux@2"
        }
      ],
      "editor/context": [
        {
          "submenu": "tiermux.editorSubmenu",
          "when": "editorHasSelection",
          "group": "1_tiermux"
        }
      ],
      "tiermux.editorSubmenu": [
        {
          "command": "tiermux.addSelectionToChat",
          "group": "1@1"
        },
        {
          "command": "tiermux.explainSelection",
          "group": "1@2"
        },
        {
          "command": "tiermux.fixSelection",
          "group": "1@3"
        },
        {
          "command": "tiermux.refactorSelection",
          "group": "1@4"
        },
        {
          "command": "tiermux.generateTests",
          "group": "1@5"
        },
        {
          "command": "tiermux.generateDocs",
          "group": "1@6"
        }
      ],
      "scm/title": [
        {
          "command": "tiermux.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "tiermux.generateCommitMessage",
          "when": "scmProvider == git"
        }
      ]
    },
    "submenus": [
      {
        "id": "tiermux.editorSubmenu",
        "label": "TierMux"
      }
    ],
    "keybindings": [
      {
        "command": "tiermux.inlineChat",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      },
      {
        "command": "tiermux.addSelectionToChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorHasSelection && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "TierMux",
      "properties": {
        "tiermux.agent.maxStepsPerTurn": {
          "type": "number",
          "default": 50,
          "description": "Hard ceiling on the number of tool-loop steps in a SINGLE agent turn (0 = no limit). A backstop for the one runaway shape the other brakes miss: many distinct mutating tool calls (none exact-repeating, all 'real progress') that nonetheless sprawl. Fires as a budget-style cutoff (bounded by maxBudgetContinuations), not a resumable pause. Default 50: a legit task rarely exceeds 50 steps in one turn — long tasks span auto-continue rounds instead."
        },
        "tiermux.agent.maxConcurrentRuns": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Maximum number of chat sessions that run their agent at the same time. Extra sends queue and start as a slot frees, to respect free-tier rate limits."
        },
        "tiermux.agent.requireWriteConfirmation": {
          "type": "boolean",
          "default": true,
          "description": "Ask before the agent writes, creates or deletes a file (and before inline chat applies an edit). Off: file changes run without a prompt; shell commands still follow \"Command approval mode\"."
        },
        "tiermux.agent.verifyCommand": {
          "type": "string",
          "default": "auto",
          "description": "Command run automatically after a turn edits files, to verify the project still works (a non-zero exit triggers bounded fix-and-recheck rounds). 'auto' detects it from the project (package.json test/typecheck/lint/build script, Makefile check/test, cargo test, go test, pytest, composer test); the planner's 'Verify:' line overrides per task; any other value is used verbatim; 'off' disables."
        },
        "tiermux.agent.verifyFixRounds": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "description": "When the verify command fails after a turn edits files, the failure output is fed back to the agent for up to this many fix-and-recheck rounds before the turn reports failure. The agent owns the recheck — no manual re-run needed. 0 reports the failure without retrying (it does not disable the check; set tiermux.agent.verifyCommand to 'off' for that)."
        },
        "tiermux.agent.toolCompaction": {
          "type": "string",
          "enum": [
            "off",
            "light",
            "aggressive"
          ],
          "default": "light",
          "description": "Compact bulky tool results before they enter the model's context. On every step, tool outputs from EARLIER steps are replaced by a one-line stub naming the tool and its arguments, so the model can re-run it if it truly needs the content again; 'light' stubs outputs over ~2,000 characters, 'aggressive' over ~800. The most recent step's results, short outputs, and error payloads always stay verbatim. File reads ARE included — they are the largest outputs and the reason this exists. 'off' keeps every result verbatim."
        },
        "tiermux.agent.autoCondense": {
          "type": "boolean",
          "default": true,
          "description": "Automatically compact the conversation (summarize older turns) when its history approaches ~80% of the routed model's context window, before a turn starts — so the model begins with headroom instead of losing tool evidence to mid-turn pruning. The manual Compact command still works regardless."
        },
        "tiermux.agent.autoCondenseTokenCap": {
          "type": "number",
          "default": 32000,
          "minimum": 0,
          "description": "Absolute token ceiling for auto-compact targeting, even when the routed model advertises a larger context window. 0 disables the cap (window-only sizing)."
        },
        "tiermux.agent.diagTrace": {
          "type": "boolean",
          "default": false,
          "description": "Log the model's path from picker → router → provider → AI SDK (pinned value, resolved candidate, runtimeName, raw usage) to the \"TierMux Diag\" output channel. Temporary diagnostic for the wrong-provider-name / 0-token issue."
        },
        "tiermux.agent.commandApproval": {
          "type": "string",
          "enum": [
            "always",
            "allowlist",
            "never"
          ],
          "enumDescriptions": [
            "Ask for approval before every command (safest).",
            "Auto-run a small set of safe inspection/test/build commands; ask for anything else.",
            "Disable terminal command execution entirely."
          ],
          "default": "always",
          "description": "How the agent's runCommand tool is gated before running shell commands."
        },
        "tiermux.agent.commandTimeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "Maximum time (ms) a single agent command may run before it is killed."
        },
        "tiermux.agent.commandAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra command prefixes auto-runnable in 'allowlist' mode (e.g. \"php artisan migrate\"), in addition to the built-in safe defaults."
        },
        "tiermux.agent.autoCompactThreshold": {
          "type": "number",
          "default": 0.8,
          "description": "Fraction of the routed model's context window at which the conversation is automatically compacted (older turns summarized, recent ones kept verbatim). Checked before a send and after a turn settles. tiermux.agent.autoCondenseTokenCap can lower the trigger further; tiermux.agent.autoCondense turns the whole thing off."
        },
        "tiermux.context.includeOpenEditors": {
          "type": "boolean",
          "default": true,
          "description": "Each turn, silently attach the active editor (the selection, or a slice around the cursor — see ambientSliceRadius) and its live diagnostics to the model-facing prompt. The visible transcript is unchanged; this just lets \"fix this\" resolve to the cursor location."
        },
        "tiermux.context.ambientSliceRadius": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "maximum": 200,
          "description": "Lines of context on each side of the cursor to include with the active file. Lower = fewer tokens per turn (helps free-tier quotas)."
        },
        "tiermux.utilityModel": {
          "type": "string",
          "default": "auto",
          "description": "Model used for short utility tasks (chat titles, commit messages). 'auto' prefers a strong keyless model so it works without an API key; or pick a specific model in Settings → Others."
        },
        "tiermux.plan.saveToFile": {
          "type": "boolean",
          "default": true,
          "description": "Save actionable plans proposed in Plan mode as markdown checklist files you can read and edit. The plan and its live task checklist are also shown in chat."
        },
        "tiermux.plan.folder": {
          "type": "string",
          "default": ".tiermux/plans",
          "description": "Workspace-relative folder where plan files are written (one markdown file per plan)."
        },
        "tiermux.completions.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Copilot-style inline (ghost-text) completions. Off by default — high request volume against free-tier rate limits."
        },
        "tiermux.completions.model": {
          "type": "string",
          "default": "auto",
          "description": "Model id used for inline completions, or 'auto' to use a fast enabled model."
        },
        "tiermux.completions.debounceMs": {
          "type": "number",
          "default": 350,
          "description": "Debounce (ms) before requesting an inline completion."
        },
        "tiermux.catalog.url": {
          "type": "string",
          "default": "https://tiermux.mainulislam3057.workers.dev/",
          "description": "URL that supplies the model catalog. Accepts the TierMux worker JSON ({ providers: [{ provider_id, enabled, models: [...] }] }) or a legacy published-sheet CSV. Fetched in the background when the editor starts; the last fetch is cached and used offline, falling back to the built-in catalog. Leave blank to use only the built-in catalog."
        },
        "tiermux.mcpRegistryUrl": {
          "type": "string",
          "default": "",
          "description": "Optional URL to a custom curated MCP list (JSON array or {servers:[…]} in this extension's format). When set, it replaces the bundled 'Add a server' list shown when the search box is empty."
        },
        "tiermux.mcpRegistrySearchUrl": {
          "type": "string",
          "default": "https://registry.modelcontextprotocol.io",
          "description": "Base URL of the MCP registry queried by the remote search box in the MCP panel (official MCP registry by default). Blank disables remote search."
        },
        "tiermux.mcpServers": {
          "type": "object",
          "default": {},
          "markdownDescription": "MCP (Model Context Protocol) stdio servers. Their tools are exposed to the agent. Example:\n\n```json\n\"tiermux.mcpServers\": {\n  \"filesystem\": { \"command\": \"npx\", \"args\": [\"-y\", \"@modelcontextprotocol/server-filesystem\", \".\"] }\n}\n```",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "description": "stdio: executable to launch (e.g. npx, uvx, node)."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "stdio: arguments."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "stdio: extra environment variables."
              },
              "cwd": {
                "type": "string",
                "description": "stdio: working directory (defaults to the workspace root)."
              },
              "url": {
                "type": "string",
                "description": "Remote (streamable-HTTP) server endpoint URL."
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Remote: HTTP headers (e.g. Authorization)."
              },
              "disabled": {
                "type": "boolean",
                "description": "Skip this server."
              }
            }
          }
        },
        "tiermux.models.autoEnableNew": {
          "type": "boolean",
          "default": true,
          "description": "Automatically enable models newly discovered in the catalog. Models on providers you haven't enabled stay inactive regardless. Turn off to review each new model manually."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run sync:all && node esbuild.js --production && npm run build:types",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:lib": "tsc -p tsconfig.lib.json",
    "test:e2e:workReport": "esbuild scripts/workReport.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/workReport.e2e.cjs && node dist/workReport.e2e.cjs",
    "test:e2e:abort-stops-shell": "esbuild scripts/abortStopsShell.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/abortStopsShell.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/abortStopsShell.e2e.cjs",
    "test:e2e:foundation": "esbuild scripts/foundation.e2e.ts --bundle --platform=node --format=cjs --external:vscode --external:@vscode/ripgrep --outfile=dist/foundation.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/foundation.e2e.cjs",
    "test:e2e:delegate-task": "esbuild scripts/delegateTask.e2e.ts --bundle --platform=node --format=cjs --external:vscode --external:@vscode/ripgrep --outfile=dist/delegateTask.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/delegateTask.e2e.cjs",
    "test:e2e:ask-user": "esbuild scripts/askUser.e2e.ts --bundle --platform=node --format=cjs --external:vscode --external:@vscode/ripgrep --outfile=dist/askUser.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/askUser.e2e.cjs",
    "test:e2e:exit-plan-mode": "esbuild scripts/exitPlanMode.e2e.ts --bundle --platform=node --format=cjs --external:vscode --external:@vscode/ripgrep --outfile=dist/exitPlanMode.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/exitPlanMode.e2e.cjs",
    "test:e2e:think-split": "esbuild scripts/thinkSplit.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/thinkSplit.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/thinkSplit.e2e.cjs",
    "test:e2e:verify-detect": "esbuild scripts/verifyDetect.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/verifyDetect.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/verifyDetect.e2e.cjs",
    "test:e2e:checkpoint-persist": "esbuild scripts/checkpointPersist.e2e.ts --bundle --platform=node --format=cjs --external:vscode --external:@vscode/ripgrep --outfile=dist/checkpointPersist.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/checkpointPersist.e2e.cjs",
    "test:e2e:plan-structurer": "esbuild scripts/planStructurer.e2e.ts --bundle --platform=node --format=cjs --external:vscode --external:@vscode/ripgrep --outfile=dist/planStructurer.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/planStructurer.e2e.cjs",
    "test:e2e:command-classify": "esbuild scripts/commandClassify.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/commandClassify.e2e.cjs && node dist/commandClassify.e2e.cjs",
    "test:e2e:local-servers": "esbuild scripts/localServers.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/localServers.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/localServers.e2e.cjs",
    "test:e2e:fit-messages": "esbuild scripts/fitMessages.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/fitMessages.e2e.cjs && node dist/fitMessages.e2e.cjs",
    "test:e2e:condense-split": "esbuild scripts/condenseSplit.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/condenseSplit.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/condenseSplit.e2e.cjs",
    "test:e2e:rate-limit-zero": "esbuild scripts/rateLimitZero.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/rateLimitZero.e2e.cjs && node dist/rateLimitZero.e2e.cjs",
    "test:e2e:quota-persist": "esbuild scripts/quotaPersist.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/quotaPersist.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/quotaPersist.e2e.cjs",
    "test:e2e:edit-match": "esbuild scripts/editMatch.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/editMatch.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/editMatch.e2e.cjs",
