{
  "name": "tiermux",
  "displayName": "TierMux",
  "description": "Free agentic AI coding assistant for VS Code. Multiplexes many free-tier LLM providers into one self-healing surface — auto-routes, auto-fails-over, learns your codebase. Zero setup with keyless providers; bring your own keys anytime.",
  "version": "3.0.0",
  "publisher": "mainul-islam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mainulBUBT/TierMux.git"
  },
  "homepage": "https://github.com/mainulBUBT/TierMux#readme",
  "bugs": {
    "url": "https://github.com/mainulBUBT/TierMux/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "llm",
    "agent",
    "copilot",
    "coding assistant",
    "chat",
    "free",
    "openrouter",
    "groq",
    "gemini",
    "mcp",
    "autocomplete",
    "routing",
    "fallback",
    "open-source"
  ],
  "main": "./dist/extension.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.cjs",
      "require": "./dist/index.cjs"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.cjs",
      "require": "./dist/router/index.cjs"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.cjs",
      "require": "./dist/agent/index.cjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.cjs",
      "require": "./dist/providers/index.cjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.cjs",
      "require": "./dist/shared/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/extension.js",
    "dist/extension.js.map",
    "dist/index.cjs",
    "dist/index.cjs.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/router/index.cjs",
    "dist/router/index.cjs.map",
    "dist/router/index.d.ts",
    "dist/router/index.d.ts.map",
    "dist/agent/index.cjs",
    "dist/agent/index.cjs.map",
    "dist/agent/index.d.ts",
    "dist/agent/index.d.ts.map",
    "dist/providers/index.cjs",
    "dist/providers/index.cjs.map",
    "dist/providers/index.d.ts",
    "dist/providers/index.d.ts.map",
    "dist/shared/index.cjs",
    "dist/shared/index.cjs.map",
    "dist/shared/index.d.ts",
    "dist/shared/index.d.ts.map",
    "media/**/*",
    "node_modules/**/*",
    "scripts/vscodeMock.cjs",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tiermux",
          "title": "TierMux",
          "icon": "media/icon.svg"
