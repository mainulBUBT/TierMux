{
  "name": "tiermux",
  "displayName": "TierMux",
  "description": "Free agentic AI coding assistant for VS Code. Multiplexes many free-tier LLM providers into one self-healing surface — auto-routes, auto-fails-over, learns your codebase. Zero setup with keyless providers; bring your own keys anytime.",
  "version": "3.0.2",
  "publisher": "mainul-islam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mainulBUBT/TierMux.git"
  },
  "homepage": "https://github.com/mainulBUBT/TierMux#readme",
  "bugs": {
    "url": "https://github.com/mainulBUBT/TierMux/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "llm",
    "agent",
    "copilot",
    "coding assistant",
    "chat",
    "free",
    "openrouter",
    "groq",
    "gemini",
    "mcp",
    "autocomplete",
    "routing",
    "fallback",
    "open-source"
  ],
  "main": "./dist/extension.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.cjs",
      "require": "./dist/index.cjs"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.cjs",
      "require": "./dist/router/index.cjs"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.cjs",
      "require": "./dist/agent/index.cjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.cjs",
      "require": "./dist/providers/index.cjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.cjs",
      "require": "./dist/shared/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/extension.js",
    "dist/extension.js.map",
    "dist/index.cjs",
    "dist/index.cjs.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/router/index.cjs",
    "dist/router/index.cjs.map",
    "dist/router/index.d.ts",
    "dist/router/index.d.ts.map",
    "dist/agent/index.cjs",
    "dist/agent/index.cjs.map",
    "dist/agent/index.d.ts",
    "dist/agent/index.d.ts.map",
    "dist/providers/index.cjs",
    "dist/providers/index.cjs.map",
    "dist/providers/index.d.ts",
    "dist/providers/index.d.ts.map",
    "dist/shared/index.cjs",
    "dist/shared/index.cjs.map",
    "dist/shared/index.d.ts",
    "dist/shared/index.d.ts.map",
    "media/**/*",
    "node_modules/**/*",
    "scripts/vscodeMock.cjs",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tiermux",
          "title": "TierMux",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tiermux": [
        {
          "id": "tiermux.chat",
          "name": "TierMux",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "tiermux.newChat",
        "title": "New Chat",
        "category": "TierMux",
        "icon": "$(add)"
      },
      {
        "command": "tiermux.showHistory",
        "title": "Chat History",
        "category": "TierMux",
        "icon": "$(history)"
      },
      {
        "command": "tiermux.compactChat",
        "title": "Compact Conversation",
        "category": "TierMux",
        "icon": "$(fold)"
      },
      {
        "command": "tiermux.generateHandoff",
        "title": "Copy Handoff Note",
        "category": "TierMux",
        "icon": "$(export)"
      },
      {
        "command": "tiermux.openModelSettings",
        "title": "Manage Models & Keys",
        "category": "TierMux",
        "icon": "$(gear)"
      },
      {
        "command": "tiermux.showAnnouncements",
        "title": "Tips & Announcements",
        "category": "TierMux"
      },
      {
        "command": "tiermux.setApiKey",
        "title": "Set API Key",
        "category": "TierMux"
      },
      {
        "command": "tiermux.clearApiKey",
        "title": "Clear API Key",
        "category": "TierMux"
      },
      {
        "command": "tiermux.explainSelection",
        "title": "Explain Selection",
        "category": "TierMux"
      },
      {
        "command": "tiermux.fixSelection",
        "title": "Fix Selection",
        "category": "TierMux"
      },
      {
        "command": "tiermux.refactorSelection",
        "title": "Refactor Selection",
        "category": "TierMux"
      },
      {
        "command": "tiermux.generateTests",
        "title": "Generate Tests",
        "category": "TierMux"
      },
      {
        "command": "tiermux.generateDocs",
        "title": "Generate Docs",
        "category": "TierMux"
      },
      {
        "command": "tiermux.fixWithAI",
        "title": "Fix with AI",
        "category": "TierMux"
      },
      {
        "command": "tiermux.inlineChat",
        "title": "Inline Chat (Edit at Cursor)",
        "category": "TierMux"
      },
      {
        "command": "tiermux.addSelectionToChat",
        "title": "Add Selection to Chat",
        "category": "TierMux"
      },
      {
        "command": "tiermux.reconnectMcp",
        "title": "Reconnect MCP Servers",
        "category": "TierMux"
      },
      {
        "command": "tiermux.refreshModels",
        "title": "Refresh Model Catalog",
        "category": "TierMux",
        "icon": "$(sync)"
      },
      {
        "command": "tiermux.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "TierMux",
        "icon": {
          "light": "media/icon-commit-light.svg",
          "dark": "media/icon-commit-dark.svg"
        }
      },
      {
        "command": "tiermux.toggleCompletions",
        "title": "Toggle Inline Completions",
        "category": "TierMux"
      },
      {
        "command": "tiermux.editMemory",
        "title": "Edit Agent Rules (AGENTS.md)",
        "category": "TierMux",
        "icon": "$(notebook)"
      },
      {
        "command": "tiermux.addSkill",
        "title": "Add Skill from GitHub",
        "category": "TierMux",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tiermux.verifyGrounding",
        "title": "Verify Grounding",
        "category": "TierMux"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tiermux.newChat",
          "when": "view == tiermux.chat",
          "group": "navigation@1"
        },
        {
          "command": "tiermux.showHistory",
          "when": "view == tiermux.chat",
          "group": "navigation@2"
        },
        {
          "command": "tiermux.openModelSettings",
          "when": "view == tiermux.chat",
          "group": "navigation@3"
        },
        {
          "command": "tiermux.compactChat",
          "when": "view == tiermux.chat",
          "group": "1_tiermux@1"
        },
        {
          "command": "tiermux.generateHandoff",
          "when": "view == tiermux.chat",
          "group": "1_tiermux@2"
        }
      ],
      "editor/context": [
        {
          "submenu": "tiermux.editorSubmenu",
          "when": "editorHasSelection",
          "group": "1_tiermux"
        }
      ],
      "tiermux.editorSubmenu": [
        {
          "command": "tiermux.addSelectionToChat",
          "group": "1@1"
        },
        {
          "command": "tiermux.explainSelection",
          "group": "1@2"
        },
        {
          "command": "tiermux.fixSelection",
          "group": "1@3"
        },
        {
          "command": "tiermux.refactorSelection",
          "group": "1@4"
        },
        {
          "command": "tiermux.generateTests",
          "group": "1@5"
        },
        {
          "command": "tiermux.generateDocs",
          "group": "1@6"
        }
      ],
      "scm/title": [
        {
          "command": "tiermux.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "tiermux.generateCommitMessage",
          "when": "scmProvider == git"
        }
      ]
    },
    "submenus": [
      {
        "id": "tiermux.editorSubmenu",
        "label": "TierMux"
      }
    ],
    "keybindings": [
      {
        "command": "tiermux.inlineChat",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      },
      {
        "command": "tiermux.addSelectionToChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorHasSelection && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "TierMux",
      "properties": {
        "tiermux.agent.maxStepsPerTurn": {
          "type": "number",
          "default": 50,
          "description": "Hard ceiling on the number of tool-loop steps in a SINGLE agent turn (0 = no limit). A backstop for the one runaway shape the other brakes miss: many distinct mutating tool calls (none exact-repeating, all 'real progress') that nonetheless sprawl. Fires as a budget-style cutoff (bounded by maxBudgetContinuations), not a resumable pause. Default 50: a legit task rarely exceeds 50 steps in one turn — long tasks span auto-continue rounds instead."
        },
        "tiermux.agent.connectTimeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Per-candidate ceiling on time to response headers while auto mode fails over between models. Raise it only for gateways with very long prefills; lower it (e.g. 20000) if a dead provider regularly holds turns. Custom/local endpoints are exempt."
        },
        "tiermux.agent.firstContentTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "Ceiling on time to the FIRST content chunk once a stream has started, counted from the first chunk of any kind. A live-but-silent stream is abandoned after this and the next model takes over. Custom/local endpoints are exempt."
        },
        "tiermux.agent.chainDeadlineMs": {
          "type": "number",
          "default": 120000,
          "minimum": 5000,
          "description": "Auto mode stops STARTING new failover candidates once the chain has spent this long on one request (a candidate already streaming is never interrupted). Lower it to fail faster when every gateway is unresponsive."
        },
        "tiermux.agent.maxConcurrentRuns": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Maximum number of chat sessions that run their agent at the same time. Extra sends queue and start as a slot frees, to respect free-tier rate limits."
        },
        "tiermux.agent.requireWriteConfirmation": {
          "type": "boolean",
          "default": true,
          "description": "Ask before the agent writes, creates or deletes a file (and before inline chat applies an edit). Off: file changes run without a prompt; shell commands still follow \"Command approval mode\"."
        },
        "tiermux.agent.toolCompaction": {
          "type": "string",
          "enum": [
            "auto",
            "off"
          ],
          "default": "auto",
          "description": "Cline's context compaction. 'auto' compacts older conversation before a request would overflow the routed model's context window (deterministic, no extra model call). 'off' compacts only when a provider actually rejects a request as too long."
        },
        "tiermux.agent.diagTrace": {
          "type": "boolean",
          "default": false,
          "description": "Log the model's path from picker → router → provider → AI SDK (pinned value, resolved candidate, runtimeName, raw usage) to the \"TierMux Diag\" output channel. Temporary diagnostic for the wrong-provider-name / 0-token issue."
        },
        "tiermux.agent.commandApproval": {
          "type": "string",
          "enum": [
            "always",
            "allowlist",
            "never"
          ],
          "enumDescriptions": [
            "Ask for approval before every command (safest).",
            "Auto-run a small set of safe inspection/test/build commands; ask for anything else.",
            "Disable terminal command execution entirely."
          ],
          "default": "always",
          "description": "How the agent's run_commands tool is gated before running shell commands."
        },
        "tiermux.agent.commandTimeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "Maximum time (ms) one run_commands call may run before it is killed."
        },
        "tiermux.agent.commandAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra command prefixes auto-runnable in 'allowlist' mode (e.g. \"php artisan migrate\"), in addition to the built-in safe defaults."
        },
        "tiermux.context.includeOpenEditors": {
          "type": "boolean",
          "default": true,
          "description": "Each turn, silently attach the active editor (the selection, or a slice around the cursor — see ambientSliceRadius) and its live diagnostics to the model-facing prompt. The visible transcript is unchanged; this just lets \"fix this\" resolve to the cursor location."
        },
        "tiermux.context.ambientSliceRadius": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "maximum": 200,
          "description": "Lines of context on each side of the cursor to include with the active file. Lower = fewer tokens per turn (helps free-tier quotas)."
        },
        "tiermux.utilityModel": {
          "type": "string",
          "default": "auto",
          "description": "Model used for short utility tasks (chat titles, commit messages). 'auto' prefers a strong keyless model so it works without an API key; or pick a specific model in Settings → Others."
        },
        "tiermux.completions.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Copilot-style inline (ghost-text) completions. Off by default — high request volume against free-tier rate limits."
        },
        "tiermux.completions.model": {
          "type": "string",
          "default": "auto",
          "description": "Model id used for inline completions, or 'auto' to use a fast enabled model."
        },
        "tiermux.completions.debounceMs": {
          "type": "number",
          "default": 350,
          "description": "Debounce (ms) before requesting an inline completion."
        },
        "tiermux.catalog.url": {
          "type": "string",
          "default": "https://tiermux.mainulislam3057.workers.dev/",
          "description": "URL that supplies the model catalog. Accepts the TierMux worker JSON ({ providers: [{ provider_id, enabled, models: [...] }] }) or a legacy published-sheet CSV. Fetched in the background when the editor starts; the last fetch is cached and used offline, falling back to the built-in catalog. Leave blank to use only the built-in catalog."
        },
        "tiermux.skillRegistrySearchUrl": {
          "type": "string",
          "default": "https://skills.sh",
          "description": "Base URL of the agent-skills directory searched by the Skills panel's remote box (skills.sh by default). Results come from whoever published them, so they are never shown as first-party — read the source before installing. Blank disables remote search; the curated list still works."
        },
        "tiermux.skillRegistryUrl": {
          "type": "string",
          "default": "",
          "description": "Replaces the live skill list. Left blank (the default), the Skills panel uses the catalog worker's /skills endpoint plus the list shipped with TierMux. Set this to browse a third-party catalog as well — e.g. https://cline.github.io/marketplace/catalog.json — any URL serving {entries:[{type:'skill', name, description, install:{args:['owner/repo','--skill','name']}}]} works. Because a skill runs with the agent's permissions, entries from a URL set here are merged in last: they can never replace a known skill or be shown as first-party."
        },
        "tiermux.mcpRegistryUrl": {
          "type": "string",
          "default": "",
          "description": "Optional URL to a custom curated MCP list (JSON array or {servers:[…]} in this extension's format). When set, it replaces the bundled 'Add a server' list shown when the search box is empty."
        },
        "tiermux.mcpRegistrySearchUrl": {
          "type": "string",
          "default": "https://registry.modelcontextprotocol.io",
          "description": "Base URL of the MCP registry queried by the remote search box in the MCP panel (official MCP registry by default). Blank disables remote search."
        },
        "tiermux.mcpServers": {
          "type": "object",
          "default": {},
          "markdownDescription": "MCP (Model Context Protocol) stdio servers. Their tools are exposed to the agent. Example:\n\n```json\n\"tiermux.mcpServers\": {\n  \"filesystem\": { \"command\": \"npx\", \"args\": [\"-y\", \"@modelcontextprotocol/server-filesystem\", \".\"] }\n}\n```",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "description": "stdio: executable to launch (e.g. npx, uvx, node)."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "stdio: arguments."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "stdio: extra environment variables."
              },
              "cwd": {
                "type": "string",
                "description": "stdio: working directory (defaults to the workspace root)."
              },
              "url": {
                "type": "string",
                "description": "Remote (streamable-HTTP) server endpoint URL."
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Remote: HTTP headers (e.g. Authorization)."
              },
              "disabled": {
                "type": "boolean",
                "description": "Skip this server."
              }
            }
          }
        },
        "tiermux.models.autoEnableNew": {
          "type": "boolean",
          "default": true,
          "description": "Automatically enable models newly discovered in the catalog. Models on providers you haven't enabled stay inactive regardless. Turn off to review each new model manually."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run sync:all && node esbuild.js --production && npm run build:types",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:lib": "tsc -p tsconfig.lib.json",
    "test:e2e:foundation": "esbuild scripts/foundation.e2e.ts --bundle --platform=node --format=cjs --external:vscode --external:@vscode/ripgrep --outfile=dist/foundation.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/foundation.e2e.cjs",
    "test:e2e:think-split": "esbuild scripts/thinkSplit.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/thinkSplit.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/thinkSplit.e2e.cjs",
    "test:e2e:opencode-lane": "esbuild scripts/opencodeLane.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/opencodeLane.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/opencodeLane.e2e.cjs",
    "test:e2e:checkpoint-persist": "esbuild scripts/checkpointPersist.e2e.ts --bundle --platform=node --format=cjs --external:vscode --external:@vscode/ripgrep --outfile=dist/checkpointPersist.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/checkpointPersist.e2e.cjs",
    "test:e2e:command-classify": "esbuild scripts/commandClassify.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/commandClassify.e2e.cjs && node dist/commandClassify.e2e.cjs",
    "test:e2e:local-servers": "esbuild scripts/localServers.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/localServers.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/localServers.e2e.cjs",
    "test:e2e:fit-messages": "esbuild scripts/fitMessages.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/fitMessages.e2e.cjs && node dist/fitMessages.e2e.cjs",
    "test:e2e:rate-limit-zero": "esbuild scripts/rateLimitZero.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/rateLimitZero.e2e.cjs && node dist/rateLimitZero.e2e.cjs",
    "test:e2e:quota-persist": "esbuild scripts/quotaPersist.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/quotaPersist.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/quotaPersist.e2e.cjs",
    "test:e2e:close-loop": "esbuild scripts/closeLoop.e2e.ts --bundle --platform=node --format=cjs --external:vscode --external:@vscode/ripgrep --outfile=dist/closeLoop.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/closeLoop.e2e.cjs",
    "test:e2e:length-continue": "esbuild scripts/lengthContinue.e2e.ts --bundle --platform=node --format=cjs --external:vscode --external:@vscode/ripgrep --outfile=dist/lengthContinue.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/lengthContinue.e2e.cjs",
    "test:e2e:session-store": "esbuild scripts/sessionStore.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/sessionStore.e2e.cjs && node dist/sessionStore.e2e.cjs",
    "test:e2e:inline-tool-dialect": "esbuild scripts/inlineToolDialect.e2e.ts --bundle --platform=node --format=cjs --external:vscode --external:@vscode/ripgrep --outfile=dist/inlineToolDialect.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/inlineToolDialect.e2e.cjs",
    "test:e2e:read-loop": "esbuild scripts/readLoop.e2e.ts --bundle --platform=node --format=cjs --external:vscode --external:@vscode/ripgrep --outfile=dist/readLoop.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/readLoop.e2e.cjs",
    "test:e2e:cline-engine": "esbuild scripts/clineEngine.e2e.ts --bundle --platform=node --format=cjs --external:vscode --external:@vscode/ripgrep --outfile=dist/clineEngine.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/clineEngine.e2e.cjs",
    "test:e2e:routing-gates": "esbuild scripts/routingGates.e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/routingGates.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/routingGates.e2e.cjs",
    "test:e2e:edit-gate": "esbuild scripts/editGate.e2e.ts --bundle --platform=node --format=cjs --external:vscode --external:@vscode/ripgrep --outfile=dist/editGate.e2e.cjs && node -r ./scripts/vscodeMock.cjs dist/editGate.e2e.cjs",
    "package": "vsce package",
    "package:all": "bash scripts/package-targets.sh",
    "publish:all": "npm run build && node scripts/packageAllTargets.mjs --publish",
    "sync:catalog": "node scripts/sync-catalog.mjs && node scripts/validate-catalog.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "validate:catalog:offline": "node scripts/validate-catalog.mjs --offline",
    "sync:providers": "node scripts/sync-providers.mjs --apply",
    "sync:all": "npm run sync:catalog && npm run sync:providers && npm run sync:readme",
    "publish": "node scripts/publish-targets.mjs",
    "prepare": "husky",
    "sync:readme": "node scripts/sync-readme.mjs",
    "check:readme": "node scripts/sync-readme.mjs --check",
